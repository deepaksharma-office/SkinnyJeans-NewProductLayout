{{ 'image-texts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }}{
    background: {{ section.settings.sectionbackground }};
  }
{%- endstyle -%}
<div class="page-width container">
  <div class="section-{{ section.id }}-padding">
    <div class="imagetext__custom-container">
      <div class="imagetext__custom-wrap content-position-{{ section.settings.position | default: 'left' }}">
        <div class="image__container-custom">
          <div class="image__wrap-custom">
            {%- if section.settings.content_type == 'image' -%}
              {%- if section.settings.image != blank -%}
                <img
                  class="text__with-image-custom"
                  src="{{ section.settings.image | image_url }}"
                  width="{{ section.settings.image.width }}"
                  height="{{ section.settings.image.height }}"
                  alt="{{ section.settings.image.alt | default: 'Text with Image' }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- elsif section.settings.content_type == 'video' -%}
              {%- if section.settings.video != blank -%}
                {{
                  section.settings.video
                  | video_tag:
                    image_size: '1100x',
                    autoplay: true,
                    loop: true,
                    controls: false,
                    muted: true,
                    class: 'text__with-video-custom'
                }}
              {%- else -%}
                <div class="placeholder-video">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
        <div class="wrappedrelative__container-custom">
          <div
            class="wrappedcontent__container-custom content-overlay-{{ section.settings.position_overlay | default: false }} {% if section.settings.glass %}content-glass{% endif %}"
            style="
              --contentbackground: {{ section.settings.contentcolor | default: '#ffffff' }};
              --contentoverlay-width: {{ section.settings.content_width | default: 80 }}em;
              --content--left-position: {{ section.settings.left_position | default: 50 }}%;
              --content--top-position: {{ section.settings.top_position | default: 50 }}%;
            "
          >
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size | default: 'h1' }}"
                    {{ block.shopify_attributes }}
                    style="color: {{ block.settings.text_color | default: '#000000' }};"
                  >
                    {{ block.settings.heading | default: 'Image and blocks' }}
                  </h2>

                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style | default: 'caption-with-letter-spacing' }} {{ block.settings.text_style | default: 'caption-with-letter-spacing' }}--{{ block.settings.text_size | default: 'medium' }} {{ block.settings.text_style | default: 'caption-with-letter-spacing' }}"
                    {{ block.shopify_attributes }}
                    style="color: {{ block.settings.text_color | default: '#000000' }};"
                  >
                    {{ block.settings.caption | default: 'Add a tagline' | escape }}
                  </p>

                {%- when 'text' -%}
                  <div
                    class="image-with-text__text rte {{ block.settings.text_style | default: 'body' }}"
                    {{ block.shopify_attributes }}
                    style="color: {{ block.settings.text_color | default: '#000000' }};"
                  >
                    {{
                      block.settings.text
                      | default: '<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>'
                    }}
                  </div>

                {% when 'text_image_blocks' %}
                  <div class="content__wrap-looper">
                    {% for i in (1..6) %}
                      {% capture image %}image_{{ i }}{% endcapture %}
                      {% capture title %}title_{{ i }}{% endcapture %}
                      {% capture content %}content_{{ i }}{% endcapture %}
                      {% if block.settings[image] != blank %}
                        <div class="content__block-wrap">
                          <div class="content_block-image">
                            <img
                              class="image__block-wrap"
                              src="{{ block.settings[image] | image_url }}"
                              width="{{ block.settings[image].width }}"
                              height="{{ block.settings[image].height }}"
                              alt="{{ block.settings[title] | escape }} "
                              loading="lazy"
                            >
                          </div>
                          <div class="content_block-texts">
                            <h2 class="h4 block_title" style="color: {{ section.settings.color }};">
                              {{ block.settings[title] | newline_to_br }}
                            </h2>
                            <div class="block_content" style="color: {{ section.settings.color }};">
                              {{ block.settings[content] | newline_to_br }}
                            </div>
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                      style="color: {{ block.settings.text_color | default: '#ffffff' }}; background: {{ block.settings.button_color | default: '#000000' }};"
                    >
                      {{ block.settings.button_label | default: 'Button label' | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
